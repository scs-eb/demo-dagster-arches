# Staging DB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=staging
POSTGRES_DB=staging_db

# OpenRefine
BASE_URL_API=http://openrefine-demo-dagster:3333/
API_TIMEOUT=10

# Arches CLI
MANAGE_PY_PATH=/web_root/demo_arches
PGUSERNAME=postgres
PGPASSWORD=postgis
PGDBNAME=demo_arches
PGHOST=db-demo-arches-c09fc
PGPORT=5432
ELASTICSEARCH_ES_HTTP_SERVICE_PORT="9200"
ELASTICSEARCH_HOSTS=elasticsearch-demo-arches-c09fc
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq-demo-arches-c09fc

# Dagster
DAGSTER_HOME=/opt/dagster/dagster_home
# Log Level, DEBUG | INFO | ERROR
DAGSTER_LOG_LEVEL=DEBUG
