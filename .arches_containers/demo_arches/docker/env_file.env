#arches
ARCHES_PROJECT=demo_arches
PUBLIC_SERVER_PROJECT_NAME=demo-arches-c09fc
INSTALL_DEFAULT_GRAPHS=False
INSTALL_DEFAULT_CONCEPTS=False
PGUSERNAME=postgres
PGPASSWORD=postgis
PGDBNAME=demo_arches
PGHOST=db-demo-arches-c09fc
PGPORT=5432
ESHOST=elasticsearch-demo-arches-c09fc
ESPORT=9200
DJANGO_MODE=DEV
DJANGO_DEBUG=True
DJANGO_PORT=8000
DOMAIN_NAMES=*
#DJANGO_REMOTE_DEBUG=False
PYTHONUNBUFFERED=0
TZ=PST
ELASTICSEARCH_PREFIX=demo_arches

#postgresql
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgis

#elasticsearch
TZ=PST
discovery.type=single-node
xpack.security.enabled=false
ES_JAVA_OPTS="-Xms512m -Xmx512m -XX:ParallelGCThreads=1"

#rabbitmq
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_HOST=rabbitmq-demo-arches-c09fc

#webpack
NODE_OPTIONS=--max-old-space-size=10000

